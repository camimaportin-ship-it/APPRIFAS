# .env.example — Copia a .env y completa tus valores locales
# Nunca subas .env a GitHub (ya está en .gitignore)

PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Semilla de usuarios iniciales (solo se usan si la tabla usuarios está vacía)
ADMIN_SEED_USER=hans4269
ADMIN_SEED_PASS=Rifas01234
ADMIN_SEED_USER_2=sairaosorio78
ADMIN_SEED_PASS_2=Rifas01234

# --- SEGURIDAD (muy recomendado) ---------------------------------------------
# Secreto para firmar las sesiones. Usa 32+ caracteres aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se define, se genera uno temporal en cada arranque: nadie puede
# falsificar tokens, pero todos los usuarios deberán volver a iniciar sesión
# cada vez que se reinicie el servidor.
# AUTH_SECRET=

# Firma de eventos de Wompi (Dashboard → Desarrolladores → Eventos).
# Sin esta clave, en producción se rechazan los webhooks (evita que cualquiera
# marque pagos como aprobados).
# WOMPI_EVENTS_KEY=

# Token compartido opcional para el webhook de estados de WhatsApp
# (se envía en la cabecera X-Webhook-Token).
# WHATSAPP_WEBHOOK_TOKEN=

# WhatsApp / Push (opcional, se generan automáticamente si no existen)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- RESPALDOS PROGRAMADOS (opcional) ----------------------------------------
# Frecuencia en horas para respaldos automáticos en segundo plano (ej: 6 ó 12).
# BACKUP_CADA_HORAS=12
# Carpeta donde guardar los respaldos (por defecto ./backups).
# BACKUP_DIR=
# Carpeta secundaria externa (unidad USB, disco secundario, volumen montado).
# BACKUP_DIR_EXTERNO=

# Solo en Vercel (NO definir en local): lo genera Vercel al crear el Blob Store
# en Storage → Create. Sin esta variable los datos no persisten entre reinicios
# y la restauración de backups queda bloqueada con un mensaje claro.
# BLOB_READ_WRITE_TOKEN=
