# Dependencias (se instalan en el servidor según su plataforma)
node_modules/

# Sesión de WhatsApp (local auth, no subir)
.wwebjs_auth/
.wwebjs_cache/

# Base de datos local (se crea en el servidor / volumen)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak-*

# Logs / temporales
*.log
npm-debug.log*
.DS_Store

# Variables de entorno (nunca subir secretos)
.env

# Auditoría local (no subir hasta autorizar)
AUDIT.md

# Posters generados (se crean en runtime)
uploads/poster-*.png
