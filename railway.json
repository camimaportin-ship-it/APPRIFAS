{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "nixpacks": {
      "config": {
        "nodeVersion": "22",
        "aptPackages": ["python3", "build-essential"],
        "cmds": ["rm -rf node_modules", "npm install"]
      }
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}
